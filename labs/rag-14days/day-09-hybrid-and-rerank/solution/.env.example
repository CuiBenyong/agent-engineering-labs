# 向量化用 OpenAI 的 text-embedding-3-small；重排默认用 Cohere 的 rerank-v3.5。
# 两个都不填也能跑：MOCK=1 会把向量换成确定性哈希、把重排换成确定性替身。
OPENAI_API_KEY=
COHERE_API_KEY=

# 想换自部署的交叉编码器（BAAI/bge-reranker-v2-m3 挂在 text-embeddings-inference 后面），
# 填上这一行就会走自部署分支，COHERE_API_KEY 不再需要：
# RERANK_BASE_URL=http://localhost:3059
# RERANK_MODEL=

# 成本与延迟账里的占位单价，改了立刻能看到占比怎么翻转
# PRICE_EMBED_PER_MTOK=0.02
# PRICE_RERANK_PER_KSEARCH=2.0
# LAT_EMBED_MS=120
# LAT_RERANK_MS=180
