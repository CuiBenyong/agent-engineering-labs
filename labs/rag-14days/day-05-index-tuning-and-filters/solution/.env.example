# embedding 用 OpenAI text-embedding-3-small；不填也可以离线跑（推荐）
OPENAI_API_KEY=
# 带 pgvector 的 PostgreSQL。lab 根目录 docker compose up -d 起来就是这个地址
DATABASE_URL=postgres://rag:rag@localhost:5555/rag05
# 后端选择（与 D2 同一套）：留空走 OpenAI；mock = 哈希向量 + 真实 pgvector，没有 key 也能跑
EMBED_BACKEND=mock
# 表里放多少行。太小看不出索引差别，太大 embedding 会很慢
SCALE=20000
