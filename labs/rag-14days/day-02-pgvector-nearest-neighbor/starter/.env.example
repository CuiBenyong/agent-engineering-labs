# embedding 后端：不填 = OpenAI；local = 本地 @xenova/transformers；MOCK=1 = 确定性哈希向量（离线）
EMBED_BACKEND=
# 走 OpenAI 后端时需要；没有 key 就一直用 MOCK=1
OPENAI_API_KEY=
# 降维（套娃式表示）：只有 OpenAI 后端支持，留空则用模型默认的 1536 维
EMBED_DIM=
# 起了 docker compose 之后填这一行；不填则自动退回内存向量库
DATABASE_URL=postgres://rag:rag@localhost:5552/rag
# MOCK=1 时不联网、不连库：哈希向量 + 内存向量库
MOCK=
