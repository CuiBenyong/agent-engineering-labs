# 向量化用 OpenAI 的 text-embedding-3-small；生成用 Anthropic。
# 两个都不填也能跑：MOCK=1 会把向量换成确定性哈希、把生成换成模板拼接。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 留空 = 用内存存储，零依赖直接跑；
# 想跑真实链路：docker compose up -d 之后填下面这一行
# DATABASE_URL=postgres://rag:rag@localhost:5557/rag
DATABASE_URL=

# 服务端口（口径：3000 + 天号，D7 的天号是 57）
PORT=3057

# 下面几个是 rag.config.json 的临时覆盖，留空则以配置文件为准
# CHUNK_STRATEGY=heading|fixed
# EMBED_BACKEND=auto|mock|openai
# ROUTES=bm25,vector
# TOP_K=4
