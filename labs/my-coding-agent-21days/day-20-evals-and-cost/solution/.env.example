# 任何 OpenAI 兼容网关都可以填。两个例子（只是对照，不是推荐）：
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4o-mini
#   n1n         LLM_BASE_URL=https://api.n1n.ai/v1          LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# 没有 key 也能跑：MOCK=1 走离线剧本，不发任何网络请求
# MOCK=1

# 本天新增（都可选，默认全 0 = 不可用）：网关的单价，用来把 token 换算成钱。
# 币种自己填，代码不认任何币种名，只照着你填的数算。三个价都是「每百万 token」。
# LLM_PRICE_CURRENCY=元
# LLM_PRICE_IN=1
# LLM_PRICE_OUT=2
# LLM_PRICE_CACHED=0.1
