# MiniMax 开放平台：https://platform.minimaxi.com  控制台创建 API Key
# 一个 key 覆盖文本 / 图像 / 视频 / 语音四类接口；不填也可以用 MOCK=1 离线跑通
MINIMAX_API_KEY=
# 国内站默认 https://api.minimax.cn ；国际站填 https://api.minimax.io
MINIMAX_BASE_URL=https://api.minimax.cn
# 各环节模型（留空用代码里的默认值）
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MINIMAX_TTS_MODEL=speech-2.8-hd
