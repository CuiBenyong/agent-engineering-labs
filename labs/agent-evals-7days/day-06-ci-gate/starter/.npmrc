# 每个 lab 是自包含的包，不参与仓库根的 workspace
ignore-workspace=true

# pnpm 11 起 strictDepBuilds 默认为 true：esbuild（tsx 的传递依赖）的构建脚本
# 被忽略就从警告升级成致命错误。而 `pnpm start` 之前会跑一次 runDepsStatusCheck、
# 内部重新调用 install，于是 install 的失败会连累 start 一起起不来。
# 关掉这个预检查，让 start 直接运行已经装好的依赖。
# install 那一步另外需要 `--config.strict-dep-builds=false`，见 README。
verify-deps-before-run=false
